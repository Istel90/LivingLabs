# Copy this file to .env.local. Never commit the populated .env.local file.
VITE_VWORLD_API_KEY=
VITE_VWORLD_DOMAIN=http://127.0.0.1:5175/
KMA_API_KEY=

# Local restored database or a remotely hosted PostGIS endpoint.
VWORLD_POSTGIS_HOST=127.0.0.1
VWORLD_POSTGIS_PORT=5432
VWORLD_POSTGIS_DATABASE=vworld_cadastral
VWORLD_POSTGIS_USER=postgres
VWORLD_POSTGIS_PASSWORD=

# Optional proxy runtime setting.
VWORLD_PROXY_PORT=5176

